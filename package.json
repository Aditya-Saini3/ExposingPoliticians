{
  "name": "exposing-politicians",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Self-updating public record of criminal cases declared by Indian politicians, with news coverage as supporting evidence.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "fetch:affidavits": "node scripts/fetch-affidavits.mjs",
