    "update-data": "npm run fetch:affidavits && npm run fetch:news"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "cheerio": "1.0.0",
    "fast-xml-parser": "4.5.0",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
